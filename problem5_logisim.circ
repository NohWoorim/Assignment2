  <vhdl appearance="logisim_evolution" name="problem5">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity problem5 is&#13;
    port (&#13;
        vt : in  std_logic_vector(12 downto 0);&#13;
        en : in  std_logic;&#13;
        a, b, c, d, e, f, g, dp : out std_logic&#13;
    );&#13;
end problem5;&#13;
&#13;
architecture bhv of problem5 is&#13;
begin&#13;
    process(vt, en)&#13;
        variable count : integer range 0 to 15;&#13;
    begin&#13;
        if en = '0' then&#13;
            a &lt;= '0'; b &lt;= '0'; c &lt;= '0'; d &lt;= '0';&#13;
            e &lt;= '0'; f &lt;= '0'; g &lt;= '0'; dp &lt;= '0';&#13;
        else&#13;
            count := 0;&#13;
&#13;
            for i in vt'range loop&#13;
                if vt(i) = '1' then&#13;
                    count := count + 1;&#13;
                end if;&#13;
            end loop;&#13;
&#13;
            dp &lt;= '0';&#13;
&#13;
            case count is&#13;
                when 0  =&gt; a &lt;= '1'; b &lt;= '1'; c &lt;= '1'; d &lt;= '1'; e &lt;= '1'; f &lt;= '1'; g &lt;= '0';&#13;
                when 1  =&gt; a &lt;= '0'; b &lt;= '1'; c &lt;= '1'; d &lt;= '0'; e &lt;= '0'; f &lt;= '0'; g &lt;= '0';&#13;
